{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swarr-listen-together-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-28",
  "durable_objects": {
    "bindings": [
      { "name": "CLIENT_SESSIONS", "class_name": "ClientSession" },
      { "name": "ROOMS", "class_name": "ListenTogetherRoom" },
      { "name": "RATE_LIMITERS", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ClientSession", "ListenTogetherRoom", "RateLimiter"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
