# ─────────────────────────────────────────────────────────────────────────────
# Swarr Website & Admin CMS — Environment Variables Template
# Copy this file to `.env` for local development (never commit `.env` to Git).
# On Netlify or Vercel, configure these in your project's Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server / Serverless Configuration (Private — never prefixed with VITE_) ───
PORT=3000

# Authorized Super Admin Google email (must match Google OAuth & firestore.rules)
ADMIN_EMAIL=

# Optional comma-separated additional Super Admin emails
EXTRA_ADMIN_EMAILS=

# Admin session idle timeout in minutes (15-480, default: 60)
ADMIN_SESSION_TTL_MINUTES=60

# Firebase Project ID used by serverless functions to verify RS256 ID tokens
FIREBASE_PROJECT_ID=

# Optional comma-separated allowed production/preview origins for CORS
# Example: https://swarr.app,https://swarr.netlify.app,https://swarr.vercel.app
ALLOWED_ORIGINS=

# ── Public Firebase Web Client Config (Required on Netlify & Vercel builds) ───
# Locally, these can also be loaded automatically from `firebase-applet-config.json`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
